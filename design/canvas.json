  "annotations": [
    { "id": "overview", "x": -420, "y": -40, "w": 360, "text": "\ubc1d\uc740\ud0dc \ud55c\uc758\uc6d0 \ub79c\ub529\ud398\uc774\uc9c0 \uc640\uc774\uc5b4\ud504\ub808\uc784 (1\ucc28\uc548)\n\n\ud55c \ud398\uc774\uc9c0 \uc2a4\ud06c\ub864 \uad6c\uc870. \uc21c\uc11c:\n1) \ud5e4\ub85c \u00b7 \ube0c\ub79c\ub4dc \uba54\uc2dc\uc9c0\n2) '\ud0dc(\u80ce)'\uc758 \uc758\ubbf8 \u2014 \ube0c\ub79c\ub4dc \uc2a4\ud1a0\ub9ac\n3) \uc9c4\ub8cc\uacfc\ubaa9 2\ud2b8\ub799 \ubd84\uae30\n4) \uc7a5\uc0c1\ud53c\ud654\uc0dd \u00b7 \uc704\ucd95\uc131\uc704\uc5fc \uc0c1\uc138 (\ub0b4\uc2dc\uacbd \uc804\ud6c4)\n5) \ubc1d\uc740\ud0dc \ub2e4\uc774\uc5b4\ud2b8 \uc0c1\uc138 (\uc778\ubc14\ub514 \uc804\ud6c4)\n6) \uc6d0\uc7a5 \uc18c\uac1c\n7) \uc624\uc2dc\ub294 \uae38 \u00b7 \uc9c4\ub8cc\uc2dc\uac04\n8) \uce74\uce74\uc624\ud1a1 \uc0c1\ub2f4 CTA \u00b7 \ud478\ud130\n\n\ud68c\uc0c9 \ubc15\uc2a4 = \uc774\ubbf8\uc9c0/\uc9c0\ub3c4 \uc790\ub9ac (\ucd94\ud6c4 \uc0bd\uc785)\n\ube68\uac04 \uba54\ubaa8 = \uc6d0\uc7a5\ub2d8 \ud655\uc778/\uacb0\uc815 \ud544\uc694 \ud56d\ubaa9" },
    { "id": "logo-note", "x": -420, "y": 620, "w": 360, "text": "\ub85c\uace0\ub294 \uc81c\uc791 \uc911 \u2192 \ucd08\uae30\uc5d4 \ud14d\uc2a4\ud2b8 \uc6cc\ub4dc\ub9c8\ud06c + \uc784\uc2dc \uc2ec\ubcfc(\uc6d0+\ud0c0\uc6d0)\ub85c \uc9c4\ud589, \ucd5c\uc885 \ub85c\uace0 \uc218\ub839 \uc2dc \uad50\uccb4.\n\ub808\ud37c\ub7f0\uc2a4 \uc2ec\ubcfc: \uc22b\uae08 \ub77c\uc778 \uc6d0(\uc528\uc557/\uc54c) + \uac80\uc740 \ud0c0\uc6d0(\uadf8\ub9bc\uc790).\n\uc804\ubc18 \ud1a4: \uae54\ub054\ud568 \u00b7 \uc2ec\ud50c \u00b7 \ud2b8\ub80c\ub514 (\ube14\ub8e8/\ud30c\uc2a4\ud154 \uacc4\uc5f4 \uac00\ub2a5)." },
    { "id": "track-branch", "x": -420, "y": 1720, "w": 360, "text": "\uc9c4\ub8cc\uacfc\ubaa9\uc740 2\ud2b8\ub799\uc73c\ub85c \uba85\ud655\ud788 \ubd84\uae30.\nTRACK A \u2014 \uc704\uc7a5(\uc7a5\uc0c1\ud53c\ud654\uc0dd/\uc704\ucd95\uc131\uc704\uc5fc), \uc2dc\uc220\uc548\uc728 = \ud55c\uc57d\nTRACK B \u2014 \ub2e4\uc774\uc5b4\ud2b8, \uc2dc\uc220\uc548\uc728 = \ub2e4\uc774\uc5b4\ud2b8 \ud55c\uc57d\n\uac01 \ud2b8\ub799\uc740 \uac1c\uc694 \uce74\ub4dc \u2192 \uc804\uc6a9 \uc0c1\uc138 \uc139\uc158\uc73c\ub85c \uc5f0\uacb0." },
    { "id": "compliance", "x": -420, "y": 2500, "w": 360, "text": "\uc804\ud6c4 \ube44\uad50 \uc0ac\uc9c4 (\ub0b4\uc2dc\uacbd \u00b7 \uc778\ubc14\ub514):\n- \uc2e4\uc81c \ud658\uc790 \ub3d9\uc758 \ud6c4 \uac8c\uc7ac\n- \"\ud6a8\uacfc\ub294 \uac1c\uc778\ucc28\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4\" \ubb38\uad6c \ud544\uc218\n- \uc758\ub8cc\uad11\uace0 \uc0ac\uc804\uc2ec\uc758 \ub300\uc0c1 \uc5ec\ubd80 \ud655\uc778 \ud544\uc694\n\ub3c4\uba54\uc778/\ud638\uc2a4\ud305 \ubbf8\ubcf4\uc720 \u2192 \uad6c\ub9e4 \uc548\ub0b4 \uc608\uc815.\n\uc624\ud508 \ubaa9\ud45c: 2026\ub144 9\uc6d4 \uc911." }
  ],
