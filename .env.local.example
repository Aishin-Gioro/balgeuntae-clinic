# ─────────────────────────────────────────────────────────────
# 전후 사진 열람 게이트 — 카카오 로그인
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 제외)
# ─────────────────────────────────────────────────────────────

# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션
#  - [앱 키] > REST API 키
KAKAO_REST_API_KEY=

#  - [카카오 로그인] > 보안 > Client Secret (사용함으로 설정한 경우에만 입력)
KAKAO_CLIENT_SECRET=

#  - [카카오 로그인] > Redirect URI 에 아래 값을 그대로 등록해야 함
#    로컬:  http://localhost:3000/api/auth/kakao/callback
#    배포:  https://<도메인>/api/auth/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# 세션 쿠키 서명용 비밀키 (16자 이상, 아무 랜덤 문자열)
#  생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  (관리자 로그인 세션도 이 키로 서명합니다)
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────
# 관리자 페이지(/admin) — 원장님 콘텐츠 편집
# ─────────────────────────────────────────────────────────────

# 관리자 로그인 비밀번호 (4자 이상). 원장님께만 공유.
ADMIN_PASSWORD=

# Vercel Blob 저장소 토큰 — 배포 환경에서만 필요.
#  Vercel 대시보드 > Storage > Blob 스토어 생성 후 프로젝트에 연결하면 자동 주입됩니다.
#  로컬에서 Blob 대신 파일로 테스트하려면 이 값을 비워두세요( .data/ 폴더 사용 ).
#  로컬에서 Blob 을 직접 쓰려면: `vercel env pull .env.local` 로 받아오세요.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────
# 분석 도구 — Google Tag Manager (GA4·Clarity 태그는 GTM 화면에서 관리)
# ─────────────────────────────────────────────────────────────

# 배포(Production) 환경에만 설정 권장. 비워두면 GTM을 로드하지 않는다(로컬 테스트 데이터가 섞이지 않게).
NEXT_PUBLIC_GTM_ID=
